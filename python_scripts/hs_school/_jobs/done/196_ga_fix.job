set-scores GA --file hsfha_scores_estimated.csv --reason "hsfdatabase/no-source score replaced by HSFHA-GA score (David 2026-11-10 rule)" --commit
same-score-fix GA --commit
import-games GA --file hsfha_import_GA.csv --reason "HSFHA-GA (hsfha.org) games missing from HS_Scores; data-sharing agreement with Loren Maxwell" --commit
dedup GA
review-pairs GA
query GA season_date.sql
query GA forfeits.sql
query GA college_check.sql
