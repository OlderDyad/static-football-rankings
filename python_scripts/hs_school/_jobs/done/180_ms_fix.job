set-dates MS --file hsfha_dates_hsfdatabase.csv --reason "hsfdatabase estimated date replaced by HSFHA-MS game date (both teams + score match)" --commit
set-dates MS --file hsfha_dates_far.csv --reason "estimated date (>10 days off) replaced by HSFHA-MS date: same teams + same score in season" --commit
set-scores MS --file hsfha_scores_estimated.csv --reason "hsfdatabase/no-source score replaced by HSFHA-MS score (David 2026-11-10 rule)" --commit
import-games MS --file hsfha_import_MS.csv --reason "HSFHA-MS (hsfha.org) games missing from HS_Scores; data-sharing agreement with Loren Maxwell"
