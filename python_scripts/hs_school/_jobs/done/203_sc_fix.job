set-scores SC --file hsfha_scores_estimated.csv --reason "hsfdatabase/no-source score replaced by HSFHA-SC score (David 2026-11-10 rule)" --commit
same-score-fix SC --commit
import-games SC --file hsfha_import_SC.csv --reason "HSFHA-SC (hsfha.org) games missing from HS_Scores; data-sharing agreement with Loren Maxwell" --commit
dedup SC
review-pairs SC
query SC season_date.sql
query SC forfeits.sql
query SC college_check.sql
