# Lyman (WY) held Lyman SD (Presho) games vs SD schools (Rapid City Journal / Argus Leader) and Lyman NE games vs Kimball/Hay Springs
move-team WY --from "Lyman (WY)" --to "Presho Lyman (SD)" --seasons 1948-2026 --ids WY_lyman_to_sd_ids.csv --reason "Lyman (WY) games vs SD opponents are Presho Lyman (SD)" --commit
move-team WY --from "Lyman (WY)" --to "Lyman (NE)" --seasons 1948-2026 --ids WY_lyman_to_ne_ids.csv --reason "Lyman (WY) games vs Kimball/Hay Springs NE are Lyman (NE)" --commit
