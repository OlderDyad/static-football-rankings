# 2. Pre-consolidation move-team splits
move-team CT --from "New London Buckeley (CT)" --to "New London (CT)" --seasons 1951-1992 --ids ct_nl_from_buckeley_ids.csv --reason "1951-1992 New London HS games mis-assigned to closed Bulkeley School" --commit
move-team CT --from "New London Buckeley (CT)" --to "Hartford Bulkeley (CT)" --seasons 1952-2003 --reason "1952-2003 Hartford Bulkeley games mis-assigned to New London Buckeley" --commit
move-team CT --from "Bristol (CT)" --to "Bristol (RI)" --seasons 1967-1986 --reason "1967-1986 Bristol RI yearbook games mis-tagged as Bristol CT" --commit
move-team CT --from "Waterbury Career Academy (CT)" --to "Waterbury McTernan (CT)" --seasons 1960-1970 --reason "1961 and 1966 Chase Collegiate / McTernan games wrongly merged into Waterbury Career Academy" --commit
move-team CT --from "Cromwell (CT)" --to "Cromwell-Portland (CT)" --seasons 2015-2026 --reason "2015+ games belong to Cromwell-Portland co-op" --commit
move-team RI --from "Bristol Mt. Hope (RI)" --to "Providence Hope (RI)" --seasons 1949-1992 --reason "Pre-1993 Boston Globe games of Providence Hope mis-mapped to Bristol Mt. Hope" --commit
move-team RI --from "Pawtucket (RI)" --to "Pawtucket Shea (RI)" --seasons 1953-1953 --ids ri_pawt_shea_1953_id.csv --reason "1953-10-18 vs Providence Classical belongs to Pawtucket West/Shea" --commit

# 3. Consolidate MA, CT, NH, RI
consolidate MA
consolidate CT
consolidate NH
consolidate RI

# 4. Preview dedup, review-pairs, and same-score-fix
dedup CT
review-pairs CT
same-score-fix CT

dedup NH
review-pairs NH
same-score-fix NH

dedup RI
review-pairs RI
same-score-fix RI

same-score-fix MA
